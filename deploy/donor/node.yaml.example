# GENERATED FILE — DO NOT EDIT.
#
# Source: internal/deploy/templates/ (regenerate with `make gen-deploy`).
# Edits here are overwritten and fail the gen-deploy-check CI gate.
#
# This is a reference copy of the canonical donor deployment. The bundle your
# operator hands you via `novactl node invite` is generated from the same
# source with your identities and a pinned image digest filled in.
# nova-node configuration for example.
#
# GENERATED by `novactl node invite` — every path below corresponds to a mount
# in the compose.yaml shipped alongside it. You should not need to edit any of
# them.
#
# THREE settings are yours to choose. They are how much of your machine you are
# lending, so they are deliberately here rather than buried in a reference doc:
#
#   storage_max_bytes               how much disk this donor may fill
#   bandwidth_budget_bytes_per_day  how much traffic it may use per day
#   storage_dir                     where its state lives
#
# Everything else is explained in docs/reference/donor-configuration.md.

# --- Yours to choose -------------------------------------------------------

# Maximum bytes of replica ciphertext this donor will pin. 0 = uncapped.
# A fetch that would exceed this is refused (fail reason out_of_space).
storage_max_bytes: 536870912000

# Authoritative daily bandwidth budget, in bytes. REQUIRED and must be > 0.
# This is the umbrella budget: the donor refuses work beyond it regardless of
# what the coordinator schedules.
bandwidth_budget_bytes_per_day: 53687091200

# Durable local state (registration, cursor, desired set, verify-ack progress).
# The replica ciphertext itself lives in the Kubo sidecar's repo, not here.
storage_dir: /var/lib/nova-node/data

# --- Generated: do not edit ------------------------------------------------

# Coordinator federation endpoint, reached over the Nebula overlay.
coordinator_url: "https://10.42.0.1:9443"

# TWO SEPARATE TRUST ROOTS. The Nebula certificate authorizes membership of the
# overlay network; the federation certificate authorizes the Nova HTTP API.
# They are issued by different CAs and are not interchangeable.
federation_ca_path:   /etc/nova/federation/federation-ca.crt
federation_cert_path: /etc/nova/federation/federation.crt
federation_key_path:  /run/secrets/nova_node_federation_key
nebula_cert_path:     /etc/nebula/nebula.crt
nebula_key_path:      /run/secrets/nebula_key

# Private-IPFS swarm key, shared with the operator's swarm. Rotating this
# disconnects this donor from the swarm.
swarm_key_path: /run/secrets/ipfs_swarm_key

# Hardened Kubo sidecar HTTP API. Reachable on loopback because kubo and
# nova-node share a network namespace (see network_mode in compose.yaml) —
# without that, this address would be unreachable and nothing could be pinned.
kubo_api_addr: http://127.0.0.1:5001

# Read-source: the address the coordinator uses to reach this donor, and the
# local bind address. These are DISTINCT by design — the first is advertised,
# the second is bound.
source_nebula_addr:     "10.42.0.10:9555"
source_read_listen_addr: "0.0.0.0:9555"

# Read-source egress budget. Left unset ON PURPOSE: when unset it INHERITS
# bandwidth_budget_bytes_per_day above, so raising the umbrella raises this too.
# Set it only if you want read-serving capped separately from your overall
# budget, and see docs/reference/donor-configuration.md first.
# egress_budget_bytes_per_day: 53687091200

# Fraction of the egress budget reserved for possession-audit responses.
# Defaults to 0.01 when unset.
# audit_budget_fraction: 0.01

# Operator-declared anti-affinity hints. Informational until the operator
# verifies them at the coordinator.
failure_domain:
  provider: ""
  asn: ""
  region: ""

# Health endpoint, loopback only. The federation and read-source listeners bind
# the overlay interface instead.
health_listen_addr: "127.0.0.1:9100"
