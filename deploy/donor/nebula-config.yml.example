# GENERATED FILE — DO NOT EDIT.
#
# Source: internal/deploy/templates/ (regenerate with `make gen-deploy`).
# Edits here are overwritten and fail the gen-deploy-check CI gate.
#
# This is a reference copy of the canonical donor deployment. The bundle your
# operator hands you via `novactl node invite` is generated from the same
# source with your identities and a pinned image digest filled in.
# Nebula overlay configuration for example (overlay IP 10.42.0.10/24).
#
# The Nebula certificate/key here authorize membership of the overlay NETWORK.
# They are a different trust root from the Nova federation certificate, which
# authorizes the Nova HTTP API. Do not mix them.
pki:
  ca: /etc/nebula/nebula-ca.crt
  cert: /etc/nebula/nebula.crt
  key: /run/secrets/nebula_key

static_host_map:
  "10.42.0.1": ["203.0.113.7:4242"]

lighthouse:
  am_lighthouse: false
  hosts:
    - "10.42.0.1"

listen:
  host: 0.0.0.0
  port: 4242

tun:
  dev: nebula1

firewall:
  # Outbound is open: this donor initiates registration, heartbeats, pin
  # synchronization, and repair fetches.
  outbound:
    - port: any
      proto: any
      host: any
  # Inbound is restricted to the read-source port. The coordinator dials it for
  # donor-backed reads and possession audits, and peer donors dial it for
  # repair. Nothing else needs to reach this host over the overlay.
  inbound:
    - port: 9555
      proto: tcp
      host: any
